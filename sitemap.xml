---
layout: null
sitemap: false
---
{% comment %}
Sitemap for Google: all .html pages and all blog posts.
Old .htm pages, PDFs and other static files are left out on purpose.
A page with `sitemap: false` or `noindex: true` in its front matter is left out too.
{% endcomment %}<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for p in site.html_pages %}{% unless p.sitemap == false or p.noindex %}
  <url><loc>{{ p.url | replace: 'index.html', '' | absolute_url }}</loc></url>{% endunless %}{% endfor %}
{% for p in site.posts %}{% unless p.sitemap == false or p.noindex %}
  <url><loc>{{ p.url | absolute_url }}</loc><lastmod>{{ p.last_modified_at | default: p.date | date_to_xmlschema }}</lastmod></url>{% endunless %}{% endfor %}
</urlset>
